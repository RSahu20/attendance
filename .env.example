# Copy this file to .env and replace every change-me value before starting.
POSTGRES_USER=attendance_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=attendance
POSTGRES_APP_USER=attendance_app
POSTGRES_APP_PASSWORD=change-me-app
DATABASE_URL=postgresql+psycopg://attendance_app:change-me-app@postgres:5432/attendance
MIGRATION_DATABASE_URL=postgresql+psycopg://attendance_admin:change-me-admin@postgres:5432/attendance

APP_ENV=development
JWT_SECRET=change-me-use-a-long-random-value
JWT_ISSUER=attendance-intelligence
JWT_AUDIENCE=attendance-api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANSWER_CONFIDENCE_THRESHOLD=0.55
EMBEDDING_PROVIDER=local_sentence_transformer
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_LIMIT=8
SEMANTIC_SCORE_THRESHOLD=0.25
OCR_PROVIDER=tesseract
STORAGE_PROVIDER=local
STORAGE_ROOT=/data/attendance
EXPORT_TTL_SECONDS=3600
EXPORT_MAX_RECORDS=10000
MAX_UPLOAD_BYTES=26214400
OCR_CONFIDENCE_THRESHOLD=0.80

# Leave empty to use the frontend's same-origin Docker/Vite proxy.
VITE_API_BASE_URL=
